Version=3.6.3

# Defining colors and bold letters
lightgreen='\e[1;32m'
lightred='\e[1;31m'
red='\e[0;31m'
lightblue='\e[1;34m'
NC='\e[0m'
bold=$(tput bold)
normal=$(tput sgr0)

# Move all entries, including dotfiles, without overwriting existing payloads.
# A subshell keeps glob options local and preserves unmoved entries on failure.
migrate_directory() (
	local source=$1 destination=$2 entry target
	shopt -s dotglob nullglob
	mkdir -p -- "$destination" || return 1
	for entry in "$source"/*; do
		target="$destination/${entry##*/}"
		if [[ -d $entry && ! -L $entry && -d $target && ! -L $target ]]; then
			migrate_directory "$entry" "$target" || return 1
			continue
		fi
		if [[ -e $target || -L $target ]]; then
			printf 'Error: Cannot migrate %s: destination %s already exists\n' "$entry" "$target" >&2
			return 1
		fi
		mv -- "$entry" "$target" || return 1
	done
	rmdir -- "$source"
)

# Read complete metadata values and serialize them as literal Bash values.
pkginfo_values() {
	local line
	while IFS= read -r line; do
		if [[ $line == "$1 = "* ]]; then
			printf '%s\n' "${line#"$1 = "}"
		fi
	done < .PKGINFO
}

write_pkgbuild_scalar() {
	printf '%s=%q\n' "$1" "$2" >> PKGBUILD
}

write_pkgbuild_array() {
	local name=$1 value
	shift
	{
		printf '%s=(' "$name"
		for value in "$@"; do printf '%q ' "$value"; done
		printf ')\n'
	} >> PKGBUILD
}

print_package_report() {
	awk 'NF { for (i = 1; i <= NF; i++) { printf "%s%s", separator, $i; separator = ", " } } END { print "" }' "$1"
}

# Pipe failure checks are local to archive extraction, not unrelated pipelines.
extract_deb_member() (
	set -o pipefail
	local member=$1 command=$2
	local -a extract_command
	read -r -a extract_command <<< "$command"
	ar p "$package_with_full_path" "$member" | "${extract_command[@]}"
)

# Build a complete replacement in a private directory before updating caches.
update_database() (
	set -o pipefail
	local cache=/var/cache/debtap staging arch ubuntu_version ubuntu_host section name
	local -a base_packages
	mkdir -p "$cache" && chmod 755 "$cache" || return 1
	staging=$(mktemp -d "$cache/.update.XXXXXXXX") || return 1
	trap 'rm -rf -- "$staging"' EXIT

	echo -e "${lightgreen}==>${NC} ${bold}Synchronizing pkgfile database...${normal}"
	pkgfile -u || return 1
	case $(uname -m) in
		i686|x86_64) arch=amd64; ubuntu_host=archive.ubuntu.com/ubuntu ;;
		armv7l|armv7h) arch=armhf; ubuntu_host=ports.ubuntu.com/ubuntu-ports ;;
		aarch64) arch=arm64; ubuntu_host=ports.ubuntu.com/ubuntu-ports ;;
		*) printf 'Error: Unsupported architecture\n' >&2; return 1 ;;
	esac
	echo -e "${lightgreen}==>${NC} ${bold}Synchronizing debtap database...${normal}"
	curl -fsSL https://packages.ubuntu.com -o "$staging/ubuntu-index" || return 1
	ubuntu_version=$(grep option "$staging/ubuntu-index" | gawk -F '=' '{print $2}' | gawk '{print $1}' | grep -v option | tac | sed -n '3p' | sed 's/\("\|-updated\|-backports\)//g') || return 1
	[[ $ubuntu_version =~ ^[a-z][a-z0-9-]*$ ]] || return 1
	for section in main non-free contrib; do
		name="debian-$section-packages-files"
		curl -fsSL "https://ftp.debian.org/debian/dists/sid/$section/Contents-$arch.gz" | gzip -dc > "$staging/$name" || return 1
		[[ -s $staging/$name ]] || return 1
	done
	curl -fsSL "https://$ubuntu_host/dists/$ubuntu_version/Contents-$arch.gz" | gzip -dc > "$staging/ubuntu-packages-files" || return 1
	[[ -s $staging/ubuntu-packages-files ]] || return 1

	echo -e "${lightgreen}==>${NC} ${bold}Downloading latest virtual packages list...${normal}"
	curl -fsSL https://github.com/helixarch/virtual-packages-list-generator/archive/master.tar.gz -o "$staging/master.tar.gz" || return 1
	# Extract only the expected file, rather than arbitrary archive paths.
	tar -xzOf "$staging/master.tar.gz" virtual-packages-list-generator-master/virtual-packages > "$staging/virtual-packages" || return 1
	[[ -s $staging/virtual-packages ]] || return 1
	echo -e "${lightgreen}==>${NC} ${bold}Downloading latest AUR packages list...${normal}"
	curl -fsSL https://aur.archlinux.org/packages.gz | gzip -dc > "$staging/aur-packages" || return 1
	[[ -s $staging/aur-packages ]] || return 1

	echo -e "${lightgreen}==>${NC} ${bold}Generating extended base group packages list...${normal}"
	pacman -Qi base > "$staging/base-info" || return 1
	read -r -a base_packages <<< "$(sed -n 's/^Depends[^:]*:[[:space:]]*//p' "$staging/base-info")"
	[[ ${#base_packages[@]} -gt 0 && ${base_packages[0]} != None ]] || return 1
	for name in "${base_packages[@]}"; do
		pactree -lu "$name" >> "$staging/base-tree" || return 1
	done
	sort -u "$staging/base-tree" > "$staging/extended-base-packages-list" || return 1
	[[ -s $staging/extended-base-packages-list ]] || return 1
	printf '\n' >> "$staging/extended-base-packages-list" || return 1
	for name in debian-{main,non-free,contrib}-packages-files ubuntu-packages-files virtual-packages aur-packages extended-base-packages-list; do
		chmod 644 "$staging/$name" || return 1
	done
	for name in debian-{main,non-free,contrib}-packages-files ubuntu-packages-files virtual-packages aur-packages extended-base-packages-list; do
		mv -fT -- "$staging/$name" "$cache/$name" || return 1
	done
)

# Metadata used in filenames must remain a single, safe value, even after editing.
validate_package_identity() {
	local name=$1 version=$2 architecture=$3
	if [[ ! $name =~ ^[a-z0-9][a-z0-9@._+-]*$ ||
	      ! $version =~ ^[a-zA-Z0-9][a-zA-Z0-9._+:~-]*$ ||
	      ! $architecture =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
		printf 'Error: Invalid package name, version, or architecture\n' >&2
		return 1
	fi
}

# Run from scratch; collect only payload entries, including hidden files.
# The -- separator prevents payload filenames from becoming options.
write_payload_archive() (
	local archive=$1 include_mtree=${2:-no}
	local -a entries payload_args=() metadata=(.PKGINFO)
	[[ ! -e .INSTALL ]] || metadata+=(.INSTALL)
	[[ $include_mtree != yes ]] || metadata+=(.MTREE)
	cd "$payload_directory" || return 1
	shopt -s dotglob nullglob
	entries=(*)
	if (( ${#entries[@]} )); then
		payload_args=(-C "$payload_directory" -- "${entries[@]}")
	fi
	fakeroot tar --force-local --owner=0 --group=0 -pcf "$archive" \
		-C "$scratch_directory" "${metadata[@]}" "${payload_args[@]}"
)

write_package_mtree() (
	local -a entries payload_args=() metadata=(.PKGINFO)
	[[ ! -e .INSTALL ]] || metadata+=(.INSTALL)
	cd "$payload_directory" || return 1
	shopt -s dotglob nullglob
	entries=(./*)
	if (( ${#entries[@]} )); then
		payload_args=(-C "$payload_directory" "${entries[@]}")
	fi
	fakeroot bsdtar -czf "$scratch_directory/.MTREE" --format=mtree \
		--options='!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link' \
		-C "$scratch_directory" "${metadata[@]}" "${payload_args[@]}"
)

cleanup_conversion() {
	[[ -z ${publication_directory:-} ]] || rm -rf -- "$publication_directory"
	[[ -z ${working_directory:-} ]] || rm -rf -- "$working_directory"
}

# Options, help, database update and error messages
optionsarray=("$@")
for i in "$@"; do
	if [[ "$i" =~ ^-([huqQswpPv]*)h([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--help$ ]]; then
		help=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)u([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--update$ ]]; then
		update=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)q([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--quiet$ ]]; then
		quiet=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)Q([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--Quiet$ ]]; then
		Quiet=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)s([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--pseudo$ ]]; then
		pseudo=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)w([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--wipeout$ ]]; then
		wipeout=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)p([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--pkgbuild$ ]]; then
		pkgbuild=set
	fi
	if [[ "$i" =~ ^-([huqQswpPv]*)P([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--Pkgbuild$ ]]; then
		Pkgbuild=set
	fi
 	if [[ "$i" =~ ^-([huqQswpPv]*)v([huqQswpPv]*)$ ]] || [[ "$i" =~ ^--version$ ]]; then
		version=set
	fi
	if [[ "$i" =~ ^-o$ ]] || [[ "$i" =~ ^--output$ ]]; then
		output=set
	fi
done
if [[ $output == set ]]; then
	for ((i=0; i<${#optionsarray[@]}; i++)); do
		if [[ "${optionsarray[$i]}" =~ ^-o$ ]] || [[ "${optionsarray[$i]}" =~ ^--output$ ]]; then
			if [[ "${optionsarray[$i+1]}" == "" ]]; then
				echo -e "${red}Error: You haven't specified an output directory${NC}"; exit 1;
			elif [ -d "${optionsarray[$i+1]}" ]; then
				outputdirectory="$(realpath "${optionsarray[$i+1]}")"
			else
				echo -e "${red}Error: No output directory or invalid output directory${NC}"; exit 1;
			fi
		fi
	done
fi
if [[ $pseudo == set ]] && [[ ! -e /var/lib/pacman/sync/multilib.db ]] && [[ ! -e /var/lib/pacman/sync/multilib-testing.db ]]; then
	echo -e "${red}Error: You are either running non-x86_64 Arch Linux, or you haven't enabled multilib repository. If you are running x86_64 Arch Linux, you must enable a multilib repository and then synchronize pacman database${NC}"; exit 1
fi
if [[ $help == set ]]; then
	echo -e "Syntax: debtap -o output_directory [other_options] package_filename\n\nOptions:\n\n    -h  --help        Print this help message\n    -u  --update      Update debtap database\n    -q  --quiet       Bypass all questions, except for editing metadata file(s)\n    -Q  --Quiet       Bypass all questions (not recommended)\n    -s  --pseudo      Create a pseudo-64-bit package from a 32-bit .deb package\n    -w  --wipeout     Wipeout versions from all dependencies, conflicts etc.\n    -p  --pkgbuild    Additionally generate a PKGBUILD file\n    -P  --Pkgbuild    Generate a PKGBUILD file only\n    -o  --output      Output directory for generated package and/or PKGBUILD (optional)\n    -v  --version     Print version"; exit 0
elif [[ $version == set ]]; then
	echo -e "$Version"; exit 0
elif [[ $update == set ]]; then
    if [[ $EUID != 0 ]]; then
        echo -e "${red}Error: You must run this command with root privileges${NC}"; exit 1
    elif ! update_database; then
        echo -e "${red}Synchronization failed. Exiting...${NC}"; exit 1
    else
        echo -e "${lightgreen}==>${NC} ${bold}All steps successfully completed!${normal}"; exit 0
    fi
elif [[ "${@: -1}" == "debtap" ]] || [[ "${@: -1}" =~ /debtap$ ]] || [[ "${@: -1}" =~ ^-([qQswpPo]+)$ ]] || [[ "${@: -1}" =~ ^--([quiet|Quiet|pseudo|wipeout|pkgbuild|Pkgbuild|output]){1,}$ ]] || [[ "${@: -1}" =~ ^-(o+)$ ]] || [[ "${@: -1}" =~ ^--(output){1,}$ ]] || [[ -d "${@: -1}" ]]; then
	echo -e "${red}Error: You haven't specified a deb package${NC}\nSyntax: debtap -o output_directory [other_options] package_filename\n\nOptions:\n\n    -h  --help        Print this help message\n    -u  --update      Update debtap database\n    -q  --quiet       Bypass all questions, except for editing metadata file(s)\n    -Q  --Quiet       Bypass all questions (not recommended)\n    -s  --pseudo      Create a pseudo-64-bit package from a 32-bit .deb package\n    -w  --wipeout     Wipeout versions from all dependencies, conflicts etc.\n    -p  --pkgbuild    Additionally generate a PKGBUILD file\n    -P  --Pkgbuild    Generate a PKGBUILD file only\n    -o  --output      Output directory for generated package and/or PKGBUILD (optional)\n    -v  --version     Print version"; exit 1
elif [[ "${@: -1}" =~ ^(-)+(.)*$ ]] || [[ $(ls "${@: -1}" &> /dev/null; echo $?) != 0 ]]; then
	echo -e "${red}Error: No such file or directory or invalid option${NC}"; exit 1
elif [[ $(file -S -b "${@: -1}" | grep -q "Debian binary package"; echo $?) != 0 ]]; then
	echo -e "${red}Error: You haven't specified a valid deb package${NC}"; exit 1
fi

if [[ ! $(ls /var/cache/pkgfile | grep -E '*.files?(.[[:digit:]]{3})' 2> /dev/null) ]] || [[ ! $(ls /var/cache/debtap/*-packages-files 2> /dev/null) ]] || [[ ! -e /var/cache/debtap/extended-base-packages-list ]] || [[ ! -e /var/cache/debtap/aur-packages ]] || [[ ! -e /var/cache/debtap/virtual-packages ]]; then
	if [[ $pseudo != set ]]; then
		echo -e "${red}Error: You must run at least once \"debtap -u\" with root privileges (preferably recently), before running this script${NC}"; exit 1
	else
		echo -e "${red}Error: You must enable a multilib repository, synchronize pacman database and then run at least once \"debtap -u\" with root privileges (preferably recently), before running this script${NC}"; exit 1
	fi
fi

tar_extract_cmd() {
	local file="${@: -1}"
	local flags
	case "$file" in
		*.tar)      flags="" ;;
		*.tar.gz)   flags="z" ;;
		*.tar.xz)   flags="J" ;;
		*.tar.bz2)  flags="j" ;;
		*.tar.lzma) flags="J" ;;
		*.tar.zst)  flags="I unzstd"
			if ! which unzstd > /dev/null; then
				echo -e "${red}Error: extracting $file requires unzstd${NC}" >&2
				return 1
			fi
			;;
		*)
			echo -e "${red}Error: Don't know how to extract '$file'${NC}" >&2
			return 1
			;;
	esac
	echo "tar -x$flags"
}

# Each conversion owns its workspace; payload and scratch files never overlap.
package_with_full_path="$(readlink -f "${@: -1}")"
temporary_root=$(realpath -- "${TMPDIR:-/tmp}") || exit 1
working_directory=$(mktemp -d "$temporary_root/debtap.XXXXXXXX") || exit 1
trap cleanup_conversion EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
control_directory="$working_directory/control"
payload_directory="$working_directory/payload"
scratch_directory="$working_directory/scratch"
report_directory="$working_directory/reports"
mkdir -- "$control_directory" "$payload_directory" "$scratch_directory" "$report_directory" || exit 1
cd "$control_directory" || exit 1

echo -e "${lightgreen}==>${NC} ${bold}Extracting package data...${normal}"
control_tar_check=$(ar t "$package_with_full_path" | grep -m 1 '^control\.tar\($\|\.\)')
control_extract=$(tar_extract_cmd "$control_tar_check") || exit 1
if ! extract_deb_member "$control_tar_check" "$control_extract" || [[ ! -f control || -L control ]]; then
	printf 'Error: Cannot extract package metadata\n' >&2
	exit 1
fi
# Only copy recognized regular control files into scratch.
for metadata_file in control preinst postinst prerm postrm conffiles; do
	if [[ -e $metadata_file || -L $metadata_file ]]; then
		if [[ ! -f $metadata_file || -L $metadata_file ]]; then
			printf 'Error: Invalid control file: %s\n' "$metadata_file" >&2
			exit 1
		fi
		cp -- "$metadata_file" "$scratch_directory/$metadata_file" || exit 1
	fi
done
validate_package_identity \
	"$(sed -n 's/^Package:[[:blank:]]*//Ip' control)" \
	"$(sed -n 's/^Version:[[:blank:]]*//Ip' control)" \
	"$(sed -n 's/^Architecture:[[:blank:]]*//Ip' control)" || exit 1
if [[ $pseudo == set ]] && ! grep -q '^Architecture: *i386$' control; then
	printf 'Error: Invalid package architecture\n' >&2
	exit 1
fi

cd "$payload_directory" || exit 1
data_tar_check=$(ar t "$package_with_full_path" | grep -m 1 '^data\.tar\($\|\.\)')
data_extract=$(tar_extract_cmd "$data_tar_check") || exit 1
if ! extract_deb_member "$data_tar_check" "$data_extract"; then
	printf 'Error: Cannot extract package data\n' >&2
	exit 1
fi
for metadata_file in .PKGINFO .INSTALL .MTREE; do
	if [[ -e $metadata_file || -L $metadata_file ]]; then
		printf 'Error: Payload contains reserved package metadata: %s\n' "$metadata_file" >&2
		exit 1
	fi
done

# Fixing possible differences in filesystem hierarchy of the extracted package data, so that it matches Arch Linux filesystem hierarchy
echo -e "${lightgreen}==>${NC} ${bold}Fixing possible directories structure differencies...${normal}"
if [[ $pkgbuild == set ]] || [[ $Pkgbuild == set ]]; then
	if [[ $(find ./ -iname '*license*' | wc -l) != 0 ]]; then
		printf 'install -D -m644 %q "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" || return 1\n' "$(find ./ -iname '*license*' | sort | tail -1 | sed s'/^\.\///')" >> "$scratch_directory/pkgbuildinstallations1"
	fi
	if [[ $(find ./ -iname '*copyright*' | wc -l) != 0 ]]; then
		if [[ $(find ./ -iname '*license*' | wc -l) != 0 ]]; then
			printf 'install -D -m644 %q "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT" || return 1\n' "$(find ./ -iname '*copyright*' | sort | tail -1 | sed s'/^\.\///')" >> "$scratch_directory/pkgbuildinstallations1"
		else
			printf 'install -D -m644 %q "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" || return 1\n' "$(find ./ -iname '*copyright*' | sort | tail -1 | sed s'/^\.\///')" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ $(find ./ -iname '*eula*' | wc -l) != 0 ]]; then
		if [[ $(find ./ -iname '*license*' | wc -l) != 0 ]] || [[ $(find ./ -iname '*copyright*' | wc -l) != 0 ]]; then
			printf 'install -D -m644 %q "${pkgdir}/usr/share/licenses/${pkgname}/EULA" || return 1\n' "$(find ./ -iname '*eula*' | sort | tail -1 | sed s'/^\.\///')" >> "$scratch_directory/pkgbuildinstallations1"
		else
			printf 'install -D -m644 %q "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" || return 1\n' "$(find ./ -iname '*eula*' | sort | tail -1 | sed s'/^\.\///')" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e usr/games ]]; then
		echo 'migrate_directory usr/games usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/usr\/games\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e bin ]]; then
		echo 'migrate_directory bin usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/bin\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e sbin ]]; then
		echo 'migrate_directory sbin usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/sbin\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e usr/sbin ]]; then
		echo 'migrate_directory usr/sbin usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/usr\/sbin\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e usr/local/games ]]; then
		echo 'migrate_directory usr/local/games usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/usr\/local\/games\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e usr/local/bin ]]; then
		echo 'migrate_directory usr/local/bin usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/usr\/local\/bin\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ -e usr/local/sbin ]]; then
		echo 'migrate_directory usr/local/sbin usr/bin || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		if [[ -e usr/share/applications ]]; then
			echo -e "ls usr/share/applications/*.desktop | while read line; do\n\tsed -i s'/^Exec=\/usr\/local\/sbin\//Exec=\/usr\/bin\//g' \"\$line\"\ndone" >> "$scratch_directory/pkgbuildinstallations1"
		fi
	fi
	if [[ $pseudo != set ]]; then
		if [[ -e lib ]]; then
			echo 'migrate_directory lib usr/lib || return 1' >> "$scratch_directory/pkgbuildinstallations1"
		fi
		if [[ -e lib32 ]]; then
			if [[ $(grep -i ^Architecture: "$scratch_directory/control" | grep -q i386; echo $?) == 0 ]]; then
				echo 'migrate_directory lib32 usr/lib || return 1' >> "$scratch_directory/pkgbuildinstallations32"
			else
				echo 'migrate_directory lib32 usr/lib32 || return 1' >> "$scratch_directory/pkgbuildinstallations64"
			fi
		fi
		if [[ -e lib64 ]]; then
			echo 'migrate_directory lib64 usr/lib || return 1' >> "$scratch_directory/pkgbuildinstallations64"
		fi
		if [[ -e usr/lib32 ]] && [[ $(grep -i ^Architecture: "$scratch_directory/control" | grep -q i386; echo $?) == 0 ]]; then
			echo 'migrate_directory usr/lib32 usr/lib || return 1' >> "$scratch_directory/pkgbuildinstallations32"
		fi
		if [[ -e usr/lib64 ]]; then
			echo 'migrate_directory usr/lib64 usr/lib || return 1' >> "$scratch_directory/pkgbuildinstallations64"
		fi
		if [[ -e usr/local/lib32 ]] && [[ $(grep -i ^Architecture: "$scratch_directory/control" | grep -q i386; echo $?) == 0 ]]; then
			echo 'migrate_directory usr/local/lib32 usr/local/lib || return 1' >> "$scratch_directory/pkgbuildinstallations32"
		fi
		if [[ -e usr/local/lib64 ]]; then
