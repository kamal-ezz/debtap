			for m in $(cat $i); do
				for n in $(sort $i | uniq -c | gawk '{print $1,$2}' | sort -n | grep "^$l " | gawk '{print $2}'); do
					echo $m | grep "^$n$"
				done
			done >> $k
			if [[ $(grep -q -E "^core(-testing)?/|^extra(-testing)?/|^multilib(-testing)?/" $k; echo $?) == 0 ]]; then
